# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Prefixo para acionar comandos no WhatsApp (padrão: !)
COMMAND_PREFIX=!

# Trava de Segurança:
# true = apenas você (dono da conta) pode disparar comandos
# false = qualquer pessoa no grupo pode usar comandos
ONLY_OWNER=true

# Modo Fantasma Automático:
# true = em grupos, SEMPRE envia os resumos e respostas no seu privado em segredo
# false = envia no grupo, a menos que você digite "!resumo pv" ou "!resumo privado"
ALWAYS_PRIVATE=false

# Números autorizados adicionais (opcional, separados por vírgula):
# ALLOWED_NUMBERS=5511999999999,5521988888888
ALLOWED_NUMBERS=

# Quantidade padrão de mensagens para análise nos resumos (padrão: 50, máx: 200)
SUMMARY_MESSAGE_LIMIT=50
