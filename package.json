{
  "name": "wpp-ai-summarizer",
  "version": "1.0.0",
  "type": "module",
  "description": "Bot inteligente em Node.js e TypeScript que monitora conversas do WhatsApp e gera resumos estruturados com a API do Gemini.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "bot:start": "npm run build && pm2 start dist/index.js --name wpp-bot",
    "bot:stop": "pm2 stop wpp-bot",
    "bot:restart": "npm run build && pm2 restart wpp-bot",
    "bot:logs": "pm2 logs wpp-bot",
    "bot:status": "pm2 status"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "ai",
    "gemini",
    "automation",
    "summarizer",
    "typescript"
  ],
  "author": "Cassiano",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "@types/qrcode-terminal": "^0.12.2",
    "pm2": "^7.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
